# Environment variables for the ai-memory project
# Copy to .env (gitignored) and fill in with real values.
#
# Loading: modern shells (zsh/bash) can source it automatically via direnv,
# or export manually before starting Claude Code / Codex / OpenCode:
#   set -a; . ./.env; set +a
#
# The agents (.mcp.json, opencode.json, .codex/config.toml) interpolate these vars
# at runtime — secrets NEVER go into git.

# --- ai-memory-svc MCP (lab) -----------------------------------------------
# JWT from the Keycloak `ai-memory-svc` realm to access the MCP via Traefik forwardAuth.
# Get it with:
#   ./scripts/get-mcp-jwt.sh
# The token expires in 15min (Keycloak default); for long sessions, export with refresh.
# Lab only — in prod, the JWT will come from the corporate Keycloak via SSO/PKCE.
WIKI_SERVICE_JWT=

# --- production compose (names only; never commit values) -------------------
# Sidecar → engine session introspection. This origin is intentionally fixed to
# direct Compose DNS over http; the client rejects aliases/public hosts and
# ignores proxy environment variables. ENGINE_INTERNAL_HOST must already be in
# AI_MEMORY_ALLOWED_HOSTS (public hostname).
ENGINE_INTERNAL_URL=http://ai-memory:49374
ENGINE_INTERNAL_HOST=

# Engine: CIDR of the Caddy peer on the Docker network only. Not a wide
# private range. Measure on the host before Gate 3; XFF from untrusted
# peers must not pick the login budget bucket.
AI_MEMORY_AUTH__TRUSTED_PROXY_CIDRS=
# Engine: mount the browser app at the public host root. API and machine
# routes keep their existing paths.
AI_MEMORY_WEB_SLUG=/

# Human bootstrap. Set INITIAL_ROOT_PASSWORD for the first Gate 3 boot and
# remove it as soon as bootstrap is confirmed. Recovery stays as break-glass.
AI_MEMORY_AUTH__INITIAL_ROOT_PASSWORD=
AI_MEMORY_AUTH__RECOVERY_TOKEN=
# Stable 64-hex pepper for native `aim_` API credential hashes. Generate once
# before the first credential; changing it invalidates every existing key.
AI_MEMORY_AUTH__TOKEN_PEPPER=

# Removed: AI_MEMORY_WEB_UPSTREAM_TOKEN. Public browser routes must not inject
# the root bearer. Browser session + CSRF replace key-login UX.
